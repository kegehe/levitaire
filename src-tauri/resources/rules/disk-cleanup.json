{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "temp-user",
      "name": "用户临时文件",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "env", "var": "TEMP" },
      "strategy": { "kind": "purgeContents", "olderThanDays": 7 },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [{ "kind": "notInstalling" }],
      "consequence": "只删除 7 天前、且当前未被占用的临时文件；只读文件会跳过并在报告里单列。不会删除 Temp 目录本身 —— 删掉它会破坏 %TEMP% 默认路径，导致安装程序报错。",
      "undo": "none"
    },
    {
      "id": "explorer-cache",
      "name": "缩略图与图标缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "Microsoft\\Windows\\Explorer" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除缩略图与图标数据库，系统会按需重建（首次打开图片文件夹时会重新生成缩略图）。正在被资源管理器占用的文件会被跳过。",
      "undo": "none"
    },
    {
      "id": "crash-dumps-user",
      "name": "应用崩溃转储",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "CrashDumps" },
      "strategy": { "kind": "purgeContents", "olderThanDays": 7 },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 7 天前的应用崩溃转储文件。这些文件只用于事后排查崩溃，不再需要时可直接删除；若你正在配合开发者定位问题，请先取走需要的那份。",
      "undo": "none"
    },
    {
      "id": "d3d-shader-cache",
      "name": "显卡着色器缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "D3DSCache" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 Direct3D 着色器缓存。游戏与三维应用在下次启动时会重新编译着色器，首次进入时可能略有卡顿，之后恢复正常。",
      "undo": "none"
    },
    {
      "id": "npm-cache",
      "name": "npm 缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "npm-cache" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 npm 下载缓存。下次 npm install 需要重新联网下载依赖，离线环境下会失败。",
      "undo": "none"
    },
    {
      "id": "pnpm-store",
      "name": "pnpm 包仓库",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "pnpm\\store" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": false,
      "guard": [],
      "consequence": "删除 pnpm 的全局包仓库。pnpm 用硬链接把仓库内容接到各项目的 node_modules 上，删掉仓库会让所有 pnpm 项目下次安装时重新下载（已存在的项目目录本身不受影响）。",
      "undo": "none"
    },
    {
      "id": "pip-cache",
      "name": "pip 缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "pip\\Cache" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 pip 的轮子与源码包缓存。下次 pip install 需要重新联网下载，离线环境下会失败。",
      "undo": "none"
    },
    {
      "id": "yarn-cache",
      "name": "Yarn 缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "Yarn\\Cache" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 Yarn 的包缓存。下次安装依赖需要重新联网下载。",
      "undo": "none"
    },
    {
      "id": "go-build-cache",
      "name": "Go 构建缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "go-build" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 Go 的编译缓存。下次构建需要重新编译全部依赖，首次构建会明显变慢；不影响源码与已编译的产物。",
      "undo": "none"
    },
    {
      "id": "nuget-v3-cache",
      "name": "NuGet 缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "NuGet\\v3-cache" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 NuGet 的 HTTP 缓存。下次还原包需要重新联网下载；不影响全局包目录与项目引用。",
      "undo": "none"
    },
    {
      "id": "playwright-browsers",
      "name": "Playwright 浏览器",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "localAppData", "relative": "ms-playwright" },
      "strategy": { "kind": "purgeContents" },
      "requiresAdmin": false,
      "defaultChecked": false,
      "guard": [],
      "consequence": "删除 Playwright 下载的浏览器内核（体积通常以 GB 计）。**自动化测试会立刻不可用**，需要重新执行 playwright install 下载。默认不勾选，请确认这些浏览器当前没有在用。",
      "undo": "none"
    },
    {
      "id": "updater-cache",
      "name": "Levitaire 更新包缓存",
      "group": "cache",
      "tier": "L1",
      "target": { "kind": "knownFolder", "folder": "roamingAppData", "relative": "levitaire\\updates" },
      "strategy": { "kind": "purgeContents", "olderThanDays": 7 },
      "requiresAdmin": false,
      "defaultChecked": true,
      "guard": [],
      "consequence": "删除 7 天前的 Levitaire 安装包缓存。若你刚下载好更新但还没安装，请先完成安装再清理。",
      "undo": "none"
    },
    {
      "id": "recycle-bin",
      "name": "回收站",
      "group": "system",
      "tier": "L1",
      "target": { "kind": "shellRecycleBin" },
      "strategy": { "kind": "shellEmptyRecycleBin" },
      "requiresAdmin": false,
      "defaultChecked": false,
      "guard": [{ "kind": "confirmUnrecoverable" }],
      "consequence": "永久删除所有磁盘回收站内的全部内容，不可撤销。里面是你之前删掉的文件 —— 其中可能有你还想找回来的。这一项默认不勾选，执行前会再问你一次。",
      "undo": "none"
    }
  ]
}
