{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Levitaire",
  "version": "0.1.0",
  "identifier": "com.levitaire.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "toolbar",
        "title": "Levitaire Toolbar",
        "width": 400,
        "height": 50,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focusable": false,
        "x": 100,
        "y": 100,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ]
      },
      {
        "label": "orb",
        "title": "Levitaire Orb",
        "width": 64,
        "height": 64,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "x": 100,
        "y": 100,
        "backgroundColor": [
          0,
          0,
          0,
          0
        ]
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' blob: http://asset.localhost asset:; connect-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$TEMP/levitaire-recording/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQzQUI0MjEzMTFEQTVGNEUKUldST1g5b1JFMEtyMDYyaGtMUklUOVJWbWpIVkFmVWR4MVVPTmM5SnYwWno0L1NKcG53SWg4R3AK",
      "endpoints": [
        "https://kegehe.github.io/levitaire/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Levitaire",
    "resources": {
      "binaries/ffmpeg.exe": "ffmpeg.exe",
      "libs/onnxruntime.dll": "onnxruntime.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
